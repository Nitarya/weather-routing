# Copy to .env and fill in your own keys.
GOOGLE_MAPS_API_KEY=your-google-cloud-api-key

# Enable the Routes API, Geocoding API, Weather API and Maps JavaScript API
# for this key.
# Public-demo Basic Auth. Set a strong password before deploying; the
# username defaults to "route". The /api/health/ endpoint stays public.
APP_USERNAME=route
APP_PASSWORD=replace-with-a-strong-password

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-string
# Set this to your public domain or VM IP for deployment.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,route.example.com
